{
  "log": {
    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9099",
      "external_ui": "zashboard",
      "secret": "singbox",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "direct",
      "default_mode": "Rule"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    }
  },
  "http_clients": [
    {
      "tag": "default",
      "version": 2,
      "detour": "proxy"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns_proxy",
        "type": "tls",
        "server": "8.8.8.8"
      },
      {
        "tag": "dns_direct",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "query_type": [
          "HTTPS"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "dns_direct"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "server": "dns_fakeip"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": "geosite-cn",
        "server": "dns_fakeip"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns_direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          },
          {
            "rule_set": "geoip-cn"
          }
        ],
        "server": "dns_proxy",
        "client_subnet": "114.114.114.114/24"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns_fakeip"
      }
    ],
    "optimistic": true
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.0/30",
        "fdfe:dcba:9876::0/126"
      ],
      "stack": "mixed",
      "auto_route": true,
      "strict_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "proxy",
      "type": "selector",
      "outbounds": [
        "auto"
      ],
      "default": "auto",
      "interrupt_exist_connections": true
    },
    {
      "tag": "OpenAI",
      "type": "selector",
      "outbounds": [
        "proxy",
        "HongKong",
        "America",
        "Singapore",
        "Japan",
        "Taiwan"
      ],
      "default": "America",
      "interrupt_exist_connections": true
    },
    {
      "tag": "Talkatone",
      "type": "selector",
      "outbounds": [
        "proxy",
        "HongKong",
        "America",
        "Singapore",
        "Japan",
        "Taiwan"
      ],
      "default": "Singapore",
      "interrupt_exist_connections": true
    },
    {
      "tag": "BiliBili",
      "type": "selector",
      "outbounds": [
        "HongKong",
        "Taiwan",
        "direct"
      ],
      "default": "direct",
      "interrupt_exist_connections": true
    },
    {
      "tag": "HongKong",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "Taiwan",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "America",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "Singapore",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "Japan",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "Others",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "auto",
      "type": "urltest",
      "outbounds": [],
      "url": "http://www.gstatic.com/generate_204",
      "idle_timeout": "30m0s"
      "interval": "20m0s",
      "tolerance": 30
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "rule",
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "clash_mode": "global",
        "rule_set": "geosite-category-ads-all",
        "outbound": "proxy"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "outbound": "proxy"
      },
      {
        "domain": [
          "clash.razord.top",
          "yacd.metacubex.one",
          "yacd.haishan.me",
          "d.metacubex.one"
        ],
        "domain_suffix": [
          "clivia.fun",
          "cdn.jsdelivr.net"
        ],
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": [
              "stun",
              "dtls"
            ]
          }
        ],
        "action": "reject",
        "method": "drop"
      },
      {
        "rule_set": "talkatone-direct",
        "outbound": "direct"
      },
      {
        "rule_set": "talkatone-proxy",
        "outbound": "Talkatone"
      },
      {
        "domain_suffix": [
          "gemini.google.com",
          "robinfrontend-pa.googleapis.com",
          "claude.ai"
        ],
        "outbound": "Ai"
      },
      {
        "rule_set": [
          "geosite-ai",
          "Google"
          "Reddit"
        ],
        "outbound": "Ai"
      },
      {
        "rule_set": [
          "Bilibili"
        ],
        "outbound": "BiliBili"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": [
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "geosite-category-ads-all",
          "geosite-cn",
          "geosite-geolocation-!cn"
        ],
        "format": "binary", 
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs",
        "update_interval": "2d"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "update_interval": "2d"
      },
      {
        "type": "remote",
        "tag": [
          "talkatone-proxy",
          "talkatone-direct"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/hide3110/surge/master/rules/talkatone/{tag}.srs",
        "update_interval": "2d" 
      },
      {
        "type": "remote",
        "tag": [
          "Google",
          "Bilibili",
          "Reddit"
        ],
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/Repcz/Tool/X/sing-box/Rules/{tag}.srs",
        "update_interval": "2d" 
      },
      {
        "type": "remote", 
        "tag": "geosite-ai", 
        "format": "binary",
        "url": "https://github.com/MetaCubeX/meta-rules-dat/raw/sing/geo/geosite/category-ai-!cn.srs",
        "update_interval": "2d" 
      }
    ],
    "default_domain_resolver": "dns_direct",
    "default_http_client": "default",
    "auto_detect_interface": true,
    "find_process": true,
    "final": "proxy"
  }
}
